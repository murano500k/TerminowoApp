<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The system adds its own scrim behind 3-button navigation when contrast is enforced. -->
    <style name="Theme.Terminowo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">true</item>
    </style>
</resources>
