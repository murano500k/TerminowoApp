default_platform(:ios)

platform :ios do
  desc "Submit the latest build to App Store with release notes; auto-release on approval."
  lane :publish do
    notes = ENV["ASC_RELEASE_NOTES"] || "Bug fixes and improvements"
    version = ENV["ASC_APP_VERSION"]
    build   = ENV["ASC_BUILD_NUMBER"]

    api_key = app_store_connect_api_key(
      key_id:        ENV["ASC_API_KEY_ID"],
      issuer_id:     ENV["ASC_API_ISSUER_ID"],
      key_filepath:  ENV["ASC_API_KEY_PATH"],
      in_house:      false
    )

    upload_to_app_store(
      api_key:              api_key,
      app_identifier:       "com.stc.terminowoapp",
      app_version:          version,
      build_number:         build,
      skip_binary_upload:   true,
      skip_screenshots:     true,
      skip_metadata:        false,
      metadata_path:        "./fastlane/metadata",
      submit_for_review:    true,
      automatic_release:    true,
      force:                true,
      precheck_include_in_app_purchases: false,
      release_notes: {
        "en-US" => notes,
        "pl"    => notes
      }
    )
  end
end
